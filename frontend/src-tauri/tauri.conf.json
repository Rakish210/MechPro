{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MechPro",
  "version": "0.1.0",
  "identifier": "com.mechpro.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MechPro",
        "width": 1440,
        "height": 960,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all" }
}
